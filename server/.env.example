PORT=5000
MONGODB_URI=replace-with-your-mongodb-connection-string
MONGODB_DATABASE=studiospace
NODE_ENV=development
CLIENT_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-random-32-plus-character-secret
BETTER_AUTH_URL=http://localhost:5000
# BETTER_AUTH_URL is the public API origin and determines the generated Google
# callback URL. Keep it in sync with the redirect URI registered in Google.
# GOOGLE OAUTH SETUP:
# StudioSpace requests only openid, email, and profile, and opens the account
# chooser.
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create OAuth 2.0 Client ID (Web application type)
# 3. Add Authorized JavaScript origins:
#    - http://localhost:3000 (dev frontend)
#    - https://yourdomain.com (production frontend)
# 4. Add Authorized redirect URIs:
#    - http://localhost:5000/api/auth/callback/google (dev)
#    - https://api.yourdomain.com/api/auth/callback/google (production)
# 5. Copy the Client ID and Client Secret below:
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
