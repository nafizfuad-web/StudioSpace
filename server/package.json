{
  "name": "studiospace-server",
  "version": "1.0.0",
  "description": "StudioSpace backend server",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "seed:studios": "tsx src/scripts/seed-demo-studios.ts",
    "test": "node --import tsx --test test/session.test.ts test/require-auth.test.ts test/role.middleware.test.ts test/studio-owner.test.ts test/studio.route.test.ts test/user-role.test.ts test/booking.route.test.ts test/wishlist.route.test.ts test/demo-studios.test.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "better-auth": "^1.7.22",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "mongodb": "^6.22.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
